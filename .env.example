# Copy to .env.local for local work. Set the same names in Vercel for the live site.

# Supabase project (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Name shown in the app
NEXT_PUBLIC_APP_NAME=Stash

# Claude, for titles, summaries, tags and clusters. Server only. Never commit a real key.
# Without it the app still saves and searches, but files everything under "Unsorted".
ANTHROPIC_API_KEY=
# Optional: which Claude model reads each save.
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: free key from omdbapi.com. Gives IMDb links their title, plot and poster.
OMDB_API_KEY=

# Optional: OpenAI key, used only to turn voice notes into text. Server only. Never commit a real key.
# Without it a voice note is still saved and plays back, but has no text and lands in "Unsorted".
OPENAI_API_KEY=
# Optional: which OpenAI model transcribes.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Google Drive for the photo room. A client ID is public by design; there is no secret.
# From Google Cloud console, APIs and Services, Credentials, an OAuth client of type "Web application".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
